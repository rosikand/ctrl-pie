# PostgreSQL 14+ connection string. Leave blank for the first-run checklist.
# Example: postgresql://postgres:password@localhost:5432/ctrl_pi
DATABASE_URL=

# Hugging Face credentials stay in the backend process and never reach the browser.
HF_TOKEN=
HF_NAMESPACE=

# Modal also supports credentials from its normal local config file.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# A distinct Modal Proxy Token protects GPU inference web endpoints. API
# credentials above cannot be used as proxy credentials.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# V1 defaults to mock hardware, camera, and offline inference workloads.
CTRL_PI_MOCK_MODE=true

# Local pre-upload workspace for recorded MP4 and synchronized samples.
RECORDING_STAGING_DIR=.ctrl-pi/recordings

# Fallback capture rate when the PostgreSQL-backed Settings value is absent.
RECORDING_FPS=20

# Compose-only host binding. Keep the loopback default unless the LAN is trusted.
CTRL_PI_BIND_ADDRESS=127.0.0.1
CTRL_PI_PORT=8000

# Source development leaves this unset and uses Vite on :5173. The production
# Docker image sets /app/frontend/dist itself.
# FRONTEND_DIST_DIR=frontend/dist
