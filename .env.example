# PostgreSQL 14+ connection string. Leave blank for the first-run checklist.
# Example: postgresql://postgres:password@localhost:5432/ctrl_pi
DATABASE_URL=

# Hugging Face credentials stay in the backend process and never reach the browser.
HF_TOKEN=
HF_NAMESPACE=

# Modal also supports credentials from its normal local config file.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# A distinct Modal Proxy Token protects GPU inference web endpoints. API
# credentials above cannot be used as proxy credentials.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# V1 defaults to mock hardware, camera, and offline inference workloads.
# Setting this false selects both the real YAM driver and real Modal compute;
# hardware mode never silently falls back to MockYAMDriver.
CTRL_PI_MOCK_MODE=true

# V1.2 all-CAN YAM cells are configured and persisted in Settings. The Docker
# hardware override mounts an operator-owned local i2rt checkout at /opt/i2rt;
# provide its host path and exact 40-character commit to Compose. ctrl-pi never
# fetches an i2rt branch or silently substitutes public upstream/latest. Build
# the hardware target only with `make docker-yam-cell`; rebuild it whenever the
# configured or mounted commit changes.
CTRL_PI_I2RT_CHECKOUT=
CTRL_PI_I2RT_DEPENDENCY_COMMIT=

# Legacy one-pair bootstrap only: SocketCAN follower + serial GELLO leader +
# crank_4310. The cell setup/API is canonical for new all-CAN configurations.
YAM_CAN_INTERFACE=
YAM_LEADER_PORT=
YAM_MUJOCO_XML_PATH=
YAM_GRIPPER_TYPE=crank_4310
YAM_LEADER_CALIBRATION_ID=yam-leader
YAM_LEADER_CALIBRATION_DIR=

# Local pre-upload workspace for recorded MP4 and synchronized samples.
RECORDING_STAGING_DIR=.ctrl-pi/recordings

# Fallback capture rate when the PostgreSQL-backed Settings value is absent.
RECORDING_FPS=20

# Container/Uvicorn listen port. Set 8010 for the host-network hardware
# overrides when another host service already owns 8000.
CTRL_PI_LISTEN_PORT=8000

# Bridge-mode Compose host binding. Keep loopback unless the LAN is trusted.
CTRL_PI_BIND_ADDRESS=127.0.0.1
CTRL_PI_PORT=8000

# Source development leaves this unset and uses Vite on :5173. The production
# Docker image sets /app/frontend/dist itself.
# FRONTEND_DIST_DIR=frontend/dist
