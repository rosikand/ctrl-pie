{
  "name": "ctrl-pi",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ctrl-pi",
      "version": "0.1.0",
      "scripts": {
        "build": "npm --prefix frontend run build",
        "dev": "npm --prefix frontend run dev",
        "docs:check": "python3 scripts/validate_docs.py",
        "docs:dev": "cd docs && npx --yes mint@4.2.849 dev",
        "docs:validate": "npm run docs:check && cd docs && npx --yes mint@4.2.849 validate && npx --yes mint@4.2.849 broken-links --check-anchors"
      }
    }
  }
}
