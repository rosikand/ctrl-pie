      {
        "group": "Use ctrl-π",
        "pages": [
          "yam-setup",
          "arms",
          "recording",
          "datasets",
          "training",
          "managed-training",
          "models",
          "inference"
        ]
      },
      {
        "group": "API and SDK",
        "pages": [
          "python-sdk",
          "ai-agent-integration",
          "trainer-api"
        ]
      },
      {
        "group": "Architecture and reference",
        "pages": [
          "architecture",
          "setup",
          "yam-driver",
          "yam-field-test"
        ]
      },
      {
        "group": "Operations",
        "pages": [
          "docker-deployment",
          "development",
          "modal-operations",
          "smoke-test",
          "troubleshooting"
        ]
      },
      {
