{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ctrl-π",
  "description": "Operate YAM robot-learning workflows from recording through inference.",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "appearance": {
    "default": "light"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "/"
  },
  "favicon": "/assets/favicon.svg",
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/rosikand/ctrl-pie"
      }
    ]
  },
  "footer": {
